// The Worker that serves thewholebill.org: static assets only, no script.
// Workers Builds reads this on every deploy from main. Two things it decides:
//   assets.directory        what build.sh produced (dist/), same as the dashboard setting
//   not_found_handling      serve dist/404.html with a 404 for unknown paths. Without
//                           this, Workers returns a 404 with an EMPTY body (Pages would
//                           have served 404.html automatically; Workers is explicit).
// html_handling is the default, written out because the site depends on it:
// /methodology redirects to /methodology/ and /404.html is reachable as /404.
{
  "name": "thewholebill",
  "compatibility_date": "2026-09-02",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
